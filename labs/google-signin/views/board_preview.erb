<figure class="board-preview" aria-label="Preview of the Solstice Campaign board in Lumora">
  <div class="preview-ui" aria-hidden="true">
    <div class="preview-top">
      <div class="preview-breadcrumb"><span class="preview-mark"><%= icon("spark") %></span><span>Studio North</span><span class="preview-slash">/</span><strong>Solstice Campaign</strong></div>
      <div class="preview-presence"><span class="avatar">JL</span><span class="avatar">MV</span><span class="preview-share">Share</span></div>
    </div>
    <div class="preview-body">
      <div class="preview-sidebar">
        <strong>Workspace</strong>
        <span><%= icon("home") %> Overview</span><span class="preview-active"><%= icon("board") %> Boards</span><span><%= icon("assets") %> Assets</span><span><%= icon("reviews") %> Reviews</span>
        <strong>In this project</strong>
        <span>Creative brief</span><span>Art direction</span><span>Final exports</span>
      </div>
      <div class="preview-project">
        <div class="preview-project-head"><div><small>Summer launch</small><p>Solstice Campaign</p></div><span>In review</span></div>
        <div class="preview-tabs"><strong>Board</strong><span>Files</span><span>Activity</span></div>
        <div class="preview-columns">
          <div class="preview-column">
            <div><strong>Inspiration</strong> <span>02</span></div>
            <div class="preview-tile"><div class="board-art art-solstice"></div><strong>Color &amp; light</strong><small>6 references</small></div>
            <div class="preview-tile text-tile"><strong>Creative brief</strong><small>Updated Monday</small></div>
          </div>
          <div class="preview-column">
            <div><strong>In progress</strong> <span>01</span></div>
            <div class="preview-tile"><div class="board-art art-field"></div><strong>Poster studies</strong><small>3 drafts</small></div>
          </div>
          <div class="preview-column">
            <div><strong>In review</strong> <span>01</span></div>
            <div class="preview-tile"><div class="board-art art-orbit"></div><strong>Launch artwork</strong><small>4 comments</small></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</figure>
