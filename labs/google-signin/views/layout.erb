<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% if defined?(csrf_token) %>
    <meta name="csrf-token" content="<%= escape(csrf_token) %>">
    <script src="<%= escape(Lab::ASSETS_PATH) %>/workspace.js" defer></script>
  <% end %>
  <title><%= escape(settings.brand) %> — <%= escape(title) %></title>
  <link rel="icon" type="image/svg+xml" href="<%= escape(Lab::ASSETS_PATH) %>/<%= escape(settings.theme) %>.svg">
  <link rel="stylesheet" href="<%= escape(Lab::ASSETS_PATH) %>/lab.css?v=<%= escape(Lab::CSS_VERSION) %>">
</head>
<body class="<%= escape(settings.theme) %>">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="lab-strip">
    <a href="/">Lumora is a fictional site — HackMeStepBro reference lab · no flag</a>
  </header>
  <svg class="svg-library" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <symbol id="icon-arrow" viewBox="0 0 24 24"><path d="M4 12h15m-6-6 6 6-6 6"/></symbol>
    <symbol id="icon-chevron" viewBox="0 0 24 24"><path d="m9 6 6 6-6 6"/></symbol>
    <symbol id="icon-down" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></symbol>
    <symbol id="icon-home" viewBox="0 0 24 24"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z"/></symbol>
    <symbol id="icon-board" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M10 9v11"/></symbol>
    <symbol id="icon-assets" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="9" cy="9" r="1.5"/><path d="m21 16-5-5L8 20"/></symbol>
    <symbol id="icon-reviews" viewBox="0 0 24 24"><path d="M21 11a8 8 0 0 1-8 8H5l1.5-4A8 8 0 1 1 21 11Z"/><path d="M9 10h7m-7 4h4"/></symbol>
    <symbol id="icon-team" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 20v-2a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v2M16 5a3 3 0 0 1 0 6m2 3a4 4 0 0 1 3 4v2"/></symbol>
    <symbol id="icon-settings" viewBox="0 0 24 24"><path d="M4 7h16M4 17h16"/><circle cx="9" cy="7" r="2.5" fill="var(--icon-bg, #231c21)"/><circle cx="16" cy="17" r="2.5" fill="var(--icon-bg, #231c21)"/></symbol>
    <symbol id="icon-search" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></symbol>
    <symbol id="icon-bell" viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 6-3 7-3 9h18c0-2-3-3-3-9m-8 12a2 2 0 0 0 4 0"/></symbol>
    <symbol id="icon-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
    <symbol id="icon-screen" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M12 17v4m-4 0h8"/></symbol>
    <symbol id="icon-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol>
    <symbol id="icon-spark" viewBox="0 0 24 24"><path d="M12 2c1 6 4 9 10 10-6 1-9 4-10 10C11 16 8 13 2 12c6-1 9-4 10-10Z"/></symbol>
    <symbol id="icon-lock" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 4v3"/></symbol>
    <symbol id="icon-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></symbol>
    <symbol id="icon-keystone" viewBox="0 0 40 40">
      <path fill="currentColor" stroke="none" d="M3 33v-8A17 17 0 0 1 13 9l2 6a11 11 0 0 0-6 10v8Zm28 0v-8a11 11 0 0 0-6-10l2-6a17 17 0 0 1 10 16v8ZM15 7a19 19 0 0 1 10 0l-2 10h-6Z"/>
    </symbol>
  </svg>
  <%= yield %>
</body>
</html>
